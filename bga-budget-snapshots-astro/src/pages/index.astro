---
import BaseLayout from '../layouts/BaseLayout.astro';
import { snapshotSlugs } from '../config/snapshots.js';
---

<BaseLayout
  title="BGA Policy Budget Snapshots"
  description="BGA Policy budget snapshot prototype."
  canonical="https://www.bettergov.org/"
>
  <main class="index-page">
    <div class="shell index-page__inner">
      <p class="eyebrow">BGA Policy</p>
      <h1>Budget Snapshots</h1>
      <p class="index-page__dek">Static Astro pages populated from BetterGov through WPGraphQL.</p>
      <div class="index-page__links">
        {snapshotSlugs.map((slug) => (
          <a href={`/${slug}/`}>{slug.replaceAll('-', ' ')}</a>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>
