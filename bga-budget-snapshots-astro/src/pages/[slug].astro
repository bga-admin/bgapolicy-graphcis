---
import SnapshotPage from '../components/SnapshotPage.astro';
import { snapshotSlugs } from '../config/snapshots.js';
import { getBudgetSnapshot } from '../lib/wordpress.js';

export function getStaticPaths() {
  return snapshotSlugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = await getBudgetSnapshot(slug);
---

<SnapshotPage {post} />
